# ============================================================================
#  Пример переменных окружения. Скопируйте в `.env` и заполните значения.
#  Сервис стартует и без заполнения — AI и почта имеют graceful fallback.
# ============================================================================

# --- Приложение ---
APP_NAME="Developer Landing API"
APP_ENV=local                 # local | production
APP_DEBUG=true
APP_VERSION=1.0.0

# CORS: список origin'ов через запятую. "*" разрешает всё (только для dev).
CORS_ALLOW_ORIGINS=*

# --- AI ---
# Провайдер: openai | anthropic | none
# none (или отсутствие ключа) -> используется rule-based fallback.
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=12

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (если AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Почта (SMTP) ---
# Если не заполнено -> письма не отправляются реально, а пишутся в лог (dry-run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Developer Landing"
# Куда падают заявки (владелец сайта)
OWNER_EMAIL=owner@example.com

# --- Rate limiting (защита от спама) ---
RATE_LIMIT_MAX_REQUESTS=5      # запросов
RATE_LIMIT_WINDOW_SECONDS=600  # за окно (сек)

# --- Хранилище (файловое) ---
DATA_DIR=./data
LOG_LEVEL=INFO
